generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  name                 String?
  avatarUrl            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  notifyFavorFulfilled Boolean            @default(true)
  notifyNextTurn       Boolean            @default(true)
  notifyNextTurnFavor  Boolean            @default(true)
  notifyNudge          Boolean            @default(true)
  notifyOverride       Boolean            @default(true)
  favorsCovered        Favor[]            @relation("FavorsCovered")
  favorsOwed           Favor[]            @relation("FavorsOwed")
  nudgesReceived       NudgeLog[]         @relation("Nudged")
  nudgesSent           NudgeLog[]         @relation("Nudger")
  pushSubscriptions    PushSubscription[]
  rooms                RoomMember[]
  subgroupMembers      SubgroupMember[]
  washLogs             WashLog[]          @relation("WashedBy")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id         String       @id @default(uuid())
  name       String
  ownerId    String
  joinCode   String       @unique
  avatarUrl  String?
  createdAt  DateTime     @default(now())
  maxMembers Int          @default(4)
  favors     Favor[]
  nudgeLogs  NudgeLog[]
  members    RoomMember[]
  subgroups  Subgroup[]
  washLogs   WashLog[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Subgroup {
  id          String           @id @default(uuid())
  roomId      String
  hash        String
  queueLocked Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  members     SubgroupMember[]
  washLogs    WashLog[]

  @@unique([roomId, hash])
}

model SubgroupMember {
  id         String   @id @default(uuid())
  subgroupId String
  userId     String
  position   Int
  subgroup   Subgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subgroupId, userId])
}

model WashLog {
  id                 String    @id @default(uuid())
  roomId             String
  washedById         String
  expectedTurnUserId String?
  isOverride         Boolean   @default(false)
  washedAt           DateTime  @default(now())
  joke               String?
  favorSettled       Boolean   @default(false)
  note               String?
  subgroupId         String?
  favorsCreated      Favor[]
  room               Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  subgroup           Subgroup? @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  washedBy           User      @relation("WashedBy", fields: [washedById], references: [id], onDelete: Cascade)
}

model Favor {
  id              String    @id @default(uuid())
  roomId          String
  owedByUserId    String
  coveredByUserId String
  washLogId       String
  settled         Boolean   @default(false)
  settledAt       DateTime?
  coveredByUser   User      @relation("FavorsCovered", fields: [coveredByUserId], references: [id])
  owedByUser      User      @relation("FavorsOwed", fields: [owedByUserId], references: [id])
  room            Room      @relation(fields: [roomId], references: [id])
  washLog         WashLog   @relation(fields: [washLogId], references: [id])
}

model NudgeLog {
  id        String   @id @default(uuid())
  roomId    String
  nudgerId  String
  nudgedId  String
  createdAt DateTime @default(now())
  joke      String?
  nudged    User     @relation("Nudged", fields: [nudgedId], references: [id], onDelete: Cascade)
  nudger    User     @relation("Nudger", fields: [nudgerId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
